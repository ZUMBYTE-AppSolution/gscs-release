<?xml version="1.0" encoding="utf-8"?>
<PLUGIN name="gscs-channel-selector" Title="GSCS Kanalwahl" author="ZUMBYTE-AppSolution" version="2026.11.03b" pluginURL="https://raw.githubusercontent.com/ZUMBYTE-AppSolution/gscs-release/main/docker/unraid/gscs-channel-selector.plg" min="7.2.0" icon="server" support="https://github.com/ZUMBYTE-AppSolution/gscs-release/issues">
<DESCRIPTION>GSCS-Kanalauswahl direkt unter Docker / Container hinzufügen. Repository und Spielserver-Image bleiben gemeinsam auf dem gewählten Kanal.</DESCRIPTION>
<FILE Name="/usr/local/emhttp/plugins/gscs-channel-selector/GscsChannelSelector.page"><INLINE><![CDATA[Menu="Buttons:80"
Title="GSCS Kanalwahl"
Link="gscs-channel-selector"
Cond="preg_match('#/(AddContainer|UpdateContainer)(?:[/?]|$)#', $_SERVER['REQUEST_URI'] ?? '')"
Markdown="false"
---
<script src="/plugins/gscs-channel-selector/channels.js?v=2026.11.03" defer></script>
]]></INLINE></FILE>
<FILE Name="/usr/local/emhttp/plugins/gscs-channel-selector/channels.js"><INLINE><![CDATA['use strict';
(()=>{
 const repository='ghcr.io/zumbyte-appsolution/gscs';
 const names={alpha:'Alpha',beta:'Beta',release:'Release'};
 const manifestUrl='https://raw.githubusercontent.com/ZUMBYTE-AppSolution/gscs-release/main/docker/unraid/channels.json';
 const start=()=>{
  const input=document.querySelector('input[name="contRepository"]');if(!input)return;
  const form=input.form;if(!form)return;
  let available={alpha:true,beta:false,release:false},box=null,select=null,generated=null,scheduled=false;
  const originalReadonly=new Map();
  function reference(){const value=input.value.trim();return value.startsWith(repository+':')&&/^[A-Za-z0-9_.-]+$/.test(value.slice(repository.length+1))?value:null;}
  function gameField(){
   const field=[...form.querySelectorAll('input[name="confTarget[]"]')].filter(e=>e.value==='GSCS_CONTAINER_IMAGE').map(e=>e.closest('[id^="ConfigNum"]')?.querySelector('[name="confValue[]"]')).find(Boolean);
   return field||generated?.querySelector('[name="confValue[]"]');
  }
  function addGameField(value){
   generated=document.createElement('div');generated.hidden=true;generated.dataset.gscsChannelField='true';
   const fields={Name:'Spielserver-Image',Target:'GSCS_CONTAINER_IMAGE',Default:value,Mode:'',Description:'Verwendet dasselbe Image wie GSCS.',Type:'Variable',Display:'advanced',Required:'true',Mask:'false',Value:value};
   for(const [name,text] of Object.entries(fields)){const field=document.createElement('input');field.type='hidden';field.name='conf'+name+'[]';field.value=text;generated.append(field);}
   form.append(generated);return generated.querySelector('[name="confValue[]"]');
  }
  function syncGame(value){
   const field=gameField()||addGameField(value);
   if(generated&&!generated.contains(field)){for(const item of originalReadonly.keys())if(generated.contains(item))originalReadonly.delete(item);generated.remove();generated=null;}
   if(!originalReadonly.has(field))originalReadonly.set(field,field.readOnly);
   field.value=value;if(field instanceof HTMLInputElement)field.readOnly=true;
  }
  function remove(){
   box?.remove();box=null;select=null;generated?.remove();generated=null;
   for(const [field,readonly] of originalReadonly)if(field.isConnected)field.readOnly=readonly;
   originalReadonly.clear();
  }
  function refresh(){
   const value=reference();if(!value){remove();return;}
   const tag=value.slice(repository.length+1);
   if(!box){
    box=document.createElement('div');box.id='gscs-channel-selector';box.style.cssText='margin:0 0 12px;display:flex;align-items:center;gap:10px;flex-wrap:wrap';
    const label=document.createElement('label');label.htmlFor='gscs-update-channel';label.textContent='Updatekanal';
    select=document.createElement('select');select.id='gscs-update-channel';select.setAttribute('aria-label','GSCS Updatekanal');select.style.minWidth='220px';
    for(const [key,name] of Object.entries(names)){const option=document.createElement('option');option.value=key;option.textContent=name;select.append(option);}
    box.append(label,select);input.before(box);
    select.addEventListener('change',()=>{
     if(!Object.hasOwn(names,select.value)||select.selectedOptions[0]?.disabled)return;
     input.value=repository+':'+select.value;syncGame(input.value);input.dispatchEvent(new Event('input',{bubbles:true}));input.dispatchEvent(new Event('change',{bubbles:true}));
     // Unraid uses the container-name change event to mark the template as edited.
     if(window.jQuery)window.jQuery('input[name="contName"]').trigger('change');
     refresh();
    });
   }
   let fixed=select.querySelector('[data-gscs-fixed]');
   if(!Object.hasOwn(names,tag)){
    if(!fixed){fixed=document.createElement('option');fixed.dataset.gscsFixed='true';select.append(fixed);}
    fixed.value=tag;const label='Version '+tag+' (fest)';if(fixed.textContent!==label)fixed.textContent=label;
   }else fixed?.remove();
   for(const [key,name] of Object.entries(names)){
    const option=[...select.options].find(o=>o.value===key);const enabled=available[key]||tag===key;option.disabled=!enabled;
    const label=enabled?name:name+' (noch nicht verfügbar)';if(option.textContent!==label)option.textContent=label;
   }
   select.value=tag;syncGame(value);
  }
  function schedule(){if(scheduled)return;scheduled=true;setTimeout(()=>{scheduled=false;refresh();},0);}
  input.addEventListener('input',schedule);input.addEventListener('change',schedule);
  new MutationObserver(schedule).observe(form,{childList:true,subtree:true});
  form.addEventListener('submit',()=>{const value=reference();if(value)syncGame(value);},true);
  refresh();schedule();
  // This public manifest contains availability only; registry credentials stay on Unraid.
  const controller=new AbortController(),timeout=setTimeout(()=>controller.abort(),5000);
  fetch(manifestUrl,{credentials:'omit',referrerPolicy:'no-referrer',cache:'no-cache',signal:controller.signal}).then(async response=>{
   if(!response.ok)return;const raw=await response.text();if(raw.length>16384)return;const data=JSON.parse(raw);
   if(data.schemaVersion!==1||data.repository!==repository)return;
   available=Object.fromEntries(Object.keys(names).map(key=>[key,data.channels?.[key]?.available===true]));refresh();
  }).catch(()=>{}).finally(()=>clearTimeout(timeout));
 };
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start,{once:true});else start();
})();
]]></INLINE></FILE>
<FILE Name="/usr/local/emhttp/plugins/gscs-channel-selector/gscs.xml"><INLINE><![CDATA[<?xml version='1.0' encoding='utf-8'?>
<Container version="2">
  <Name>GSCS</Name>
  <Repository>ghcr.io/zumbyte-appsolution/gscs:alpha</Repository>
  <Registry>https://github.com/ZUMBYTE-AppSolution/gscs-release/pkgs/container/gscs</Registry>
  <Network>host</Network>
  <Privileged>false</Privileged>
  <ExtraParams />
  <Support>https://github.com/ZUMBYTE-AppSolution/gscs-release/issues</Support>
  <Project>https://github.com/ZUMBYTE-AppSolution/gscs-release</Project>
  <Overview>GSCS mit interner PostgreSQL-Datenbank, SteamCMD, Java und Wine in einem Container. Ersten Administrator und Lizenz im Webinterface einrichten. Ohne Lizenz: ein Gameserver auf localhost. Ein Node verwendet dasselbe Image mit GSCS_ROLE=node und benötigt kein Webinterface und keine Verwaltungsdatenbank.</Overview>
  <WebUI>http://[IP]:[PORT:5080]/</WebUI>
  <Icon>https://raw.githubusercontent.com/ZUMBYTE-AppSolution/gscs-release/main/assets/GSCS-256.png</Icon>
  <Config Name="Webinterface" Target="5080" Default="5080" Mode="tcp" Description="GSCS Webinterface" Type="Port" Display="always" Required="true" Mask="false">5080</Config>
  <Config Name="GSCS Daten" Target="/var/lib/gscs" Default="/mnt/disk1/appdata/gscs" Mode="rw" Description="Dauerhafte Konfiguration, Spieldateien und Backups" Type="Path" Display="always" Required="true" Mask="false">/mnt/disk1/appdata/gscs</Config>
  <Config Name="Rolle" Target="GSCS_ROLE" Default="master" Mode="" Description="Master mit Webinterface" Type="Variable" Display="advanced" Required="true" Mask="false">master</Config>
  <Config Name="Lokale Ausführung" Target="GSCS_LOCAL_NODE" Default="true" Mode="" Description="localhost als Ausführungsnode aktivieren" Type="Variable" Display="always" Required="true" Mask="false">true</Config>
  <Config Name="Host-Datenpfad" Target="GSCS_DOCKER_HOST_ROOT" Default="/mnt/disk1/appdata/gscs" Mode="" Description="Muss exakt dem Hostpfad von GSCS Daten entsprechen" Type="Variable" Display="always" Required="true" Mask="false">/mnt/disk1/appdata/gscs</Config>
  <Config Name="Spielserver-Image" Target="GSCS_CONTAINER_IMAGE" Default="ghcr.io/zumbyte-appsolution/gscs:alpha" Mode="" Description="Wird bei der Kanalauswahl automatisch mit dem GSCS-Image geändert." Type="Variable" Display="advanced" Required="true" Mask="false">ghcr.io/zumbyte-appsolution/gscs:alpha</Config>
  <Config Name="Docker-Verwaltung" Target="/var/run/docker.sock" Default="/var/run/docker.sock" Mode="rw" Description="Optional: Docker-Socket für Spielcontainer. Gewährt Hostrechte." Type="Path" Display="advanced" Required="false" Mask="false">/var/run/docker.sock</Config>
  <Config Name="Webadresse" Target="GSCS_URL" Default="http://0.0.0.0:5080" Mode="" Description="Bind-Adresse und Port des Webinterface" Type="Variable" Display="advanced" Required="false" Mask="false">http://0.0.0.0:5080</Config>
  <Config Name="Master-Adresse" Target="GSCS_MASTER_URL" Default="" Mode="" Description="Nur für Rolle node: HTTPS-Adresse des Masters" Type="Variable" Display="advanced" Required="false" Mask="false" />
  <Config Name="Node-ID" Target="GSCS_NODE_ID" Default="" Mode="" Description="Nur für Rolle node: Registrierung aus dem Webinterface" Type="Variable" Display="advanced" Required="false" Mask="false" />
  <Config Name="Node-Schlüsseldatei" Target="GSCS_AGENT_KEY_FILE" Default="" Mode="" Description="Nur für Rolle node: geschützte Datei mit Registrierungsschlüssel" Type="Variable" Display="advanced" Required="false" Mask="false" />
  <DefaultTagDescription>Alpha · neue Funktionen in Erprobung</DefaultTagDescription>
  <Branch>
    <Tag>beta</Tag>
    <TagDescription>Beta · Vorabversionen</TagDescription>
    <Config Name="Webinterface" Target="5080" Default="5080" Mode="tcp" Description="GSCS Webinterface" Type="Port" Display="always" Required="true" Mask="false">5080</Config>
    <Config Name="GSCS Daten" Target="/var/lib/gscs" Default="/mnt/disk1/appdata/gscs" Mode="rw" Description="Dauerhafte Konfiguration, Spieldateien und Backups" Type="Path" Display="always" Required="true" Mask="false">/mnt/disk1/appdata/gscs</Config>
    <Config Name="Rolle" Target="GSCS_ROLE" Default="master" Mode="" Description="Master mit Webinterface" Type="Variable" Display="advanced" Required="true" Mask="false">master</Config>
    <Config Name="Lokale Ausführung" Target="GSCS_LOCAL_NODE" Default="true" Mode="" Description="localhost als Ausführungsnode aktivieren" Type="Variable" Display="always" Required="true" Mask="false">true</Config>
    <Config Name="Host-Datenpfad" Target="GSCS_DOCKER_HOST_ROOT" Default="/mnt/disk1/appdata/gscs" Mode="" Description="Muss exakt dem Hostpfad von GSCS Daten entsprechen" Type="Variable" Display="always" Required="true" Mask="false">/mnt/disk1/appdata/gscs</Config>
    <Config Name="Spielserver-Image" Target="GSCS_CONTAINER_IMAGE" Default="ghcr.io/zumbyte-appsolution/gscs:beta" Mode="" Description="Wird bei der Kanalauswahl automatisch mit dem GSCS-Image geändert." Type="Variable" Display="advanced" Required="true" Mask="false">ghcr.io/zumbyte-appsolution/gscs:beta</Config>
    <Config Name="Docker-Verwaltung" Target="/var/run/docker.sock" Default="/var/run/docker.sock" Mode="rw" Description="Optional: Docker-Socket für Spielcontainer. Gewährt Hostrechte." Type="Path" Display="advanced" Required="false" Mask="false">/var/run/docker.sock</Config>
    <Config Name="Webadresse" Target="GSCS_URL" Default="http://0.0.0.0:5080" Mode="" Description="Bind-Adresse und Port des Webinterface" Type="Variable" Display="advanced" Required="false" Mask="false">http://0.0.0.0:5080</Config>
    <Config Name="Master-Adresse" Target="GSCS_MASTER_URL" Default="" Mode="" Description="Nur für Rolle node: HTTPS-Adresse des Masters" Type="Variable" Display="advanced" Required="false" Mask="false" />
    <Config Name="Node-ID" Target="GSCS_NODE_ID" Default="" Mode="" Description="Nur für Rolle node: Registrierung aus dem Webinterface" Type="Variable" Display="advanced" Required="false" Mask="false" />
    <Config Name="Node-Schlüsseldatei" Target="GSCS_AGENT_KEY_FILE" Default="" Mode="" Description="Nur für Rolle node: geschützte Datei mit Registrierungsschlüssel" Type="Variable" Display="advanced" Required="false" Mask="false" />
  </Branch>
  <Branch>
    <Tag>release</Tag>
    <TagDescription>Release · stabile Versionen</TagDescription>
    <Config Name="Webinterface" Target="5080" Default="5080" Mode="tcp" Description="GSCS Webinterface" Type="Port" Display="always" Required="true" Mask="false">5080</Config>
    <Config Name="GSCS Daten" Target="/var/lib/gscs" Default="/mnt/disk1/appdata/gscs" Mode="rw" Description="Dauerhafte Konfiguration, Spieldateien und Backups" Type="Path" Display="always" Required="true" Mask="false">/mnt/disk1/appdata/gscs</Config>
    <Config Name="Rolle" Target="GSCS_ROLE" Default="master" Mode="" Description="Master mit Webinterface" Type="Variable" Display="advanced" Required="true" Mask="false">master</Config>
    <Config Name="Lokale Ausführung" Target="GSCS_LOCAL_NODE" Default="true" Mode="" Description="localhost als Ausführungsnode aktivieren" Type="Variable" Display="always" Required="true" Mask="false">true</Config>
    <Config Name="Host-Datenpfad" Target="GSCS_DOCKER_HOST_ROOT" Default="/mnt/disk1/appdata/gscs" Mode="" Description="Muss exakt dem Hostpfad von GSCS Daten entsprechen" Type="Variable" Display="always" Required="true" Mask="false">/mnt/disk1/appdata/gscs</Config>
    <Config Name="Spielserver-Image" Target="GSCS_CONTAINER_IMAGE" Default="ghcr.io/zumbyte-appsolution/gscs:release" Mode="" Description="Wird bei der Kanalauswahl automatisch mit dem GSCS-Image geändert." Type="Variable" Display="advanced" Required="true" Mask="false">ghcr.io/zumbyte-appsolution/gscs:release</Config>
    <Config Name="Docker-Verwaltung" Target="/var/run/docker.sock" Default="/var/run/docker.sock" Mode="rw" Description="Optional: Docker-Socket für Spielcontainer. Gewährt Hostrechte." Type="Path" Display="advanced" Required="false" Mask="false">/var/run/docker.sock</Config>
    <Config Name="Webadresse" Target="GSCS_URL" Default="http://0.0.0.0:5080" Mode="" Description="Bind-Adresse und Port des Webinterface" Type="Variable" Display="advanced" Required="false" Mask="false">http://0.0.0.0:5080</Config>
    <Config Name="Master-Adresse" Target="GSCS_MASTER_URL" Default="" Mode="" Description="Nur für Rolle node: HTTPS-Adresse des Masters" Type="Variable" Display="advanced" Required="false" Mask="false" />
    <Config Name="Node-ID" Target="GSCS_NODE_ID" Default="" Mode="" Description="Nur für Rolle node: Registrierung aus dem Webinterface" Type="Variable" Display="advanced" Required="false" Mask="false" />
    <Config Name="Node-Schlüsseldatei" Target="GSCS_AGENT_KEY_FILE" Default="" Mode="" Description="Nur für Rolle node: geschützte Datei mit Registrierungsschlüssel" Type="Variable" Display="advanced" Required="false" Mask="false" />
  </Branch>
</Container>
]]></INLINE></FILE>
<FILE Run="/bin/bash"><INLINE><![CDATA[
set -eu
chmod 0644 /usr/local/emhttp/plugins/gscs-channel-selector/GscsChannelSelector.page /usr/local/emhttp/plugins/gscs-channel-selector/channels.js /usr/local/emhttp/plugins/gscs-channel-selector/gscs.xml
templates=/boot/config/plugins/dockerMan/templates-user
target=$templates/my-GSCS.xml
backup=/boot/config/plugins/gscs-channel-selector/backups/$(date -u +%Y%m%dT%H%M%SZ)
is_gscs() {
 php -r '$x=@simplexml_load_file($argv[1]);exit($x && (string)$x->Name === "GSCS" && str_starts_with((string)$x->Repository,"ghcr.io/zumbyte-appsolution/gscs:") ? 0 : 1);' "$1" >/dev/null 2>&1
}
mkdir -p "$templates"
if [ ! -f "$target" ]; then
 source=/usr/local/emhttp/plugins/gscs-channel-selector/gscs.xml
 for name in my-GSCS-alpha.xml my-GSCS-beta.xml my-GSCS-release.xml; do
  if is_gscs "$templates/$name"; then source=$templates/$name;break;fi
 done
 cp -- "$source" "$target.gscs-new"
 mv -- "$target.gscs-new" "$target"
fi
if is_gscs "$target"; then
 for name in my-GSCS-alpha.xml my-GSCS-beta.xml my-GSCS-release.xml; do
  if is_gscs "$templates/$name"; then
   mkdir -p "$backup"
   mv -- "$templates/$name" "$backup/$name"
  fi
 done
fi
printf 'GSCS-Kanalauswahl installiert.
'
]]></INLINE></FILE>
<FILE Run="/bin/bash" Method="remove"><INLINE><![CDATA[
set -eu
folder=/usr/local/emhttp/plugins/gscs-channel-selector
if [ -d "$folder" ]; then
 [ "$(realpath -e "$folder")" = "$folder" ] || exit 1
 rm -f -- "$folder/GscsChannelSelector.page" "$folder/channels.js" "$folder/gscs.xml"
 rmdir -- "$folder" 2>/dev/null || true
fi
]]></INLINE></FILE>
</PLUGIN>
